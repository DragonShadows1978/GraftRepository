+         "source_family": "certified_34_turn"},
+        {"fixture_id": "sup_praxis_fresh", "split": "eval",
+         "source_family": "supersession_battery_on_gpt_oss"},
+        {"fixture_id": "sup_lumen_head", "split": "eval",
+         "source_family": "supersession_battery_on_gpt_oss"},
+        {"fixture_id": "sup_orion_current", "split": "eval",
+         "source_family": "supersession_battery_on_gpt_oss"},
+    ],
+}
