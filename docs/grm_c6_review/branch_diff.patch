+    normalized = normalize_value_text(str(answer.get("normalized", "")))
+    lived_normalized = normalize_value_text(str(answer.get("lived_normalized", "")))
+    _require(
+        answer.get("normalized_match") is True
+        and bool(normalized)
+        and normalized == lived_normalized,
