+from core.grm_frame import (  # noqa: E402
+    CAPTURE_PIN_ENV, CAPTURE_PIN_LIVE, CAPTURE_PIN_MOUNT, CAPTURE_PIN_OFF,
+    SEAT_NEAR_LIVE_ENV,
+)
