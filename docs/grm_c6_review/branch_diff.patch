+            f"R1 mean_nll={r1['mean_nll']:.9f}, ppl={r1['ppl']:.6f}; C1/R1 "
+            f"mean-NLL ratio={bg1['mean_nll_ratio']:.9f}x; C2 mean_nll={c2['mean_nll']:.9f}, "
