+    observer.ngen = 2
+    rows = observer.finish()
+    assert len(rows) == 2
+    assert grm_demand.decide(rows, CARRIED)["demand_fired"] is True
+    assert grm_demand.decide(rows, CARRIED)["demand_token_index"] == 1
