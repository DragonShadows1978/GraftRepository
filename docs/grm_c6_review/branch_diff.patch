+
+def _stats(mean, flipped, broken=(), delta=0.2):
+    return {
+        "mean_mounted_mass_full_layers": mean,
+        "refusers_flipped": f"{flipped}/3",
+        "controls_broken": list(broken),
+        "delta_vs_c0_mean": delta,
+    }
