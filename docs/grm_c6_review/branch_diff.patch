+def _fork_attempt(
+    *,
+    arena: Any,
+    e2e: Any,
+    fixture: Mapping[str, Any],
+    profile: Mapping[str, Any],
+    schedule: Sequence[tuple[Sequence[int], bool]],
+    ordinal: int,
+    planned: Sequence[int],
+    fitted: Sequence[int],
