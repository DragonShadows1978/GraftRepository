+    directory = campaign_root(run_dir) / STAGE_DIRS["plant_registration"]
+    paths = sorted(directory.glob("plant_registry_*.json"))
+    _require(len(paths) == 1,
+             f"expected exactly one frozen DET1.7 plant registry, got {len(paths)}")
+    return paths[0]
