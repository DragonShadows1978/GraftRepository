+        for corpus in CORPORA
+    }
+    g2_green = all(
+        corpus_actuals[corpus] >= 8192
+        and len(receipts[corpus]) == (args.n_windows // args.windows_per_chunk)
+        and all(item.get("status") == "complete" for item in receipts[corpus])
+        for corpus in CORPORA
