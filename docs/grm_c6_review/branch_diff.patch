+def run_t4(live: LiveFixture) -> dict[str, Any]:
+    grid = []
+    masks = {}
+    for delta in T4_DELTAS:
+        outcomes = {}
+        for probe_id in ("praxis_fresh", "solace_fresh"):
+            interceptor = SDPAInterceptor("bonus", delta=delta)
