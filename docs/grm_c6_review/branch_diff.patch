+    }
+    return {
+        "fit": fit,
+        "source_manifest": source_manifest,
+        "layer": layer,
+        "tau": tau,
+        "key": key,
+        "row": row,
+        "install_row": install_row,
+        "branch": branch,
+        "branch_code": branch_code,
+        "caveat": caveat,
+        "registered_sentence": decision.get("registered_sentence"),
+    }
