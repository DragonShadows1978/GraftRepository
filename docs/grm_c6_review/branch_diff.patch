+        and t33_score.get("accepts") == [T33_EXPECTED]
+        and t33_score.get("expected") == T33_EXPECTED
+        and t33_score.get("answer") == T33_ANSWER
+        and t33_score.get("pass") is False
+        and t33_score.get("contains_expected") is False,
