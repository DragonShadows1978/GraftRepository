+                f"- Contiguous 2,560-token stream: mean_nll={c0['contiguous_mean_nll']:.9f}, ppl={c0['contiguous_ppl']:.6f}",
+                f"- Delta: mean_nll={c0['mean_nll_delta']:+.9f}, ppl ratio={c0['ppl_ratio']:.9f}x",
