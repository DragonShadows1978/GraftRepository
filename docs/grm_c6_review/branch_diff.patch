+        source: dict(source_record)
+        for source, source_record in det1_7_inventory.items()
+    }
+    origins = dict(det1_7["effective_origins"])
+
+    raw_changes = value.get("allowed_source_changes") or {}
+    raw_additions = value.get("added_sources") or {}
+    _require(
