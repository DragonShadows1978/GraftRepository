index 0000000..e51c81a
--- /dev/null
+++ b/tests/test_grm_det1_3_snapshot.py
@@ -0,0 +1,1297 @@
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from types import SimpleNamespace
