+        path = analyze(args.run_dir)
+        print(path)
+        return 0
+    except DETError as exc:
+        print(f"REFUSED: {exc}", file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
