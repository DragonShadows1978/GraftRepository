+        if not c0["complete"]:
+            return 4
+        return 0 if c0_sane else 3
+    if args.require_complete:
+        if not fg0_pass:
+            return 3 if fg0_complete else 4
+        if not c0["complete"] or not sweep_complete:
+            return 4
+        if not c0_sane or winner is None or not fg2_pass:
+            return 3
