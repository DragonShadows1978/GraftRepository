+        if withheld_for_rung:
+            delta_provenance = {
+                **provenance,
+                "schema": "grm.det1_4.fork_capture_provenance.v1",
+                "arm": "fork",
+                "protocol": ARM_PROTOCOLS["fork"],
+                "probe_driver": "grm_det1_6.inline_fork_hydration_delta",
+            }
