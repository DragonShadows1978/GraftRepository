+    source = (ROOT / "scripts" / "grm_sc1_recovery_gpu.py").read_text(
+        encoding="utf-8")
+    assert 'stem.startswith("sc1_2_")' in source
+    assert '"artifacts" / "grm_sc1_2"' in source
