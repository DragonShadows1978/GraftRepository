+            "train_pair_count": N_PAIR_TRAIN,
+            "validation_pair_count": N_PAIR_VALIDATION,
+            "train_tokens_sampled_per_window_per_epoch": int(args.train_tokens_per_window),
+            "validation_tokens": validation_tokens,
