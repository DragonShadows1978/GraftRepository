+def tokenize_guide_files(files: Sequence[Path], tokenizer: Any) -> dict[Path, np.ndarray]:
+    return {
+        path: tokenizer_ids(tokenizer, path.read_text(encoding="utf-8", errors="strict"))
+        for path in files
+    }
