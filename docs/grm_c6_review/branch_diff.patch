+        node_to_idx = {
+            str(k): int(v) for k, v in row["fixture_node_to_idx"].items()}
+        resolved = [node_to_idx[name] for name in row["live_node_ids"]]
+        assert resolved == [int(v) for v in row["live_ids"]], probe_id
