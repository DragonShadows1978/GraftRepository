+        == e1.DEFAULT_OUTPUT_DIR / "pairs_e11"
+    )
+    fg2_pass = bool(
+        self_test_payload is not None
+        and self_test_payload.get("status") == "pass"
+        and self_test_payload.get("script_sha256") == script_hash
+        and scripts_match
