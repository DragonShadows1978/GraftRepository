+import sys
+from typing import Any, Mapping, Sequence
+
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from scripts.grm_det1_common import (  # noqa: E402
+    CALIBRATION_IDS,
+    DETECTORS,
+    DETError,
+    file_record,
+    fit_thresholds,
+    race_metrics,
+    read_json,
+    read_jsonl,
