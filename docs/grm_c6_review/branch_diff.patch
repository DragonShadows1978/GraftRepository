+        receipt_path = write_content_addressed(
+            directory, "chronological_verbal_receipt", receipt)
+    _write_stage_marker(
+        run_dir,
+        stage,
+        receipt_path,
+        [
+            prerequisite,
+            Path(run_dir) / DET1_7_TERMINAL_AMENDMENT.name,
+            plant_registry_path(run_dir),
