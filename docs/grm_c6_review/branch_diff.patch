+                        cfg, where, layer, expert_mode="resident_packed_mxfp4"
+                    )
+                    configure_block(block, args.backend)
+                    h_teacher, kv_t, _route_t = block(h_teacher, cos, sin)
+                    h_base, kv_b, _route_b = block(h_base, cos, sin)
+                    if layer == install_layer:
