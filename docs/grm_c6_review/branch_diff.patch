+def _write_bytes_exclusive_or_verify(path: Path, payload: bytes) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if path.exists():
+        if path.read_bytes() != payload:
+            raise DETError(f"immutable output collision: {path}")
