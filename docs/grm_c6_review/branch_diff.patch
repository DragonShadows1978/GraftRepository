+        analysis["gates"]["CG1"]["report_line"],
+        analysis["gates"]["CG2"]["report_line"],
+        analysis["gates"]["CG3"]["report_line"],
+        "",
+        "## C0 contiguity control",
+        "",
+    ]
+    if c0.get("status") == "complete":
+        lines.extend(
+            [
