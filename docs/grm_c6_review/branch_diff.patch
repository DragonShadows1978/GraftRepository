+def pair_paths(
+    output: Path,
+    pair_index: int,
+    address_rule: str = ADDRESS_RULE_E1,
+    teacher_rule: str = TEACHER_RULE_ORIGINAL,
+) -> tuple[Path, Path]:
+    root = pair_root(output, address_rule, teacher_rule)
+    return root / f"pair_{pair_index:03d}.npz", root / f"pair_{pair_index:03d}_receipt.json"
