+        if args.mode == "analyze":
+            return analyze(args)
+        raise AssertionError(args.mode)
+    except SystemExit:
+        raise
+    except Exception as exc:
+        print(
+            json.dumps(
+                {
+                    "status": "error",
+                    "mode": args.mode,
+                    "error_type": type(exc).__name__,
+                    "error": str(exc),
+                    "traceback": traceback.format_exc(),
+                },
+                indent=2,
+            ),
+            file=sys.stderr,
+            flush=True,
+        )
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
