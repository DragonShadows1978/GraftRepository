+        incident = {"answer": "refusal", "mounted_ids": [1]}
+        nuisance_wrong = {"answer": "third", "mounted_ids": [1]}
+        fake_call = [0]
+
+        def fake_receipts(overrides: Mapping[str, Mapping[str, Any]]):
+            fake_call[0] += 1
