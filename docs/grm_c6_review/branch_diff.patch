+
+    # Two false fires -> FAIL even at perfect recall.
+    results = [
+        _e2e_result(f, reproduced=True, fired=True, recovered=True,
+                    control_fired=(f in sc12.E2E_FIXTURE_IDS[:2]))
+        for f in sc12.E2E_FIXTURE_IDS
