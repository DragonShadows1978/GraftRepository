+def tokenizer_ids(tokenizer: Any, text: str) -> np.ndarray:
+    encoded = tokenizer(
+        text,
+        add_special_tokens=False,
+        return_attention_mask=False,
+        return_token_type_ids=False,
+        verbose=False,
+    )["input_ids"]
+    return np.asarray(encoded, dtype=np.int64)
