+    root = Path(repo_root).resolve()
+    order = det17._inside_repo(  # type: ignore[attr-defined]
+        order_path, root, "DET1.8 order"
+    )
+    _require(
+        order.name == "GRM_DET1_8_SYNTH_TURN_SNAPSHOTS.md",
+        "wrong DET1.8 order",
