+def _snapshot_utf8(snapshot: Mapping[str, Any], field: str) -> str:
+    from scripts.grm_det1_3_snapshot import load_snapshot_array
+
+    return load_snapshot_array(snapshot, field).tobytes(order="C").decode("utf-8")
+
