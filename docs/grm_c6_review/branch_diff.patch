+    path = output / "cpu_self_test.json"
+    write_json(path, payload)
+    print(
+        json.dumps(
+            {
+                "status": payload["status"],
+                "checks_passed": payload["checks_passed"],
+                "checks_total": payload["checks_total"],
+                "artifact": str(path),
