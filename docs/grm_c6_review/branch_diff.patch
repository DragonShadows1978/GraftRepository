+
+def test_flip_line_alone_is_enough_for_closes():
+    got = results.verdict_for(_stats(0.40, 2), GATE)
+    assert got["verdict"] == results.CLOSES
+    assert got["meets_mass_line"] is False
+    assert got["meets_flip_line"] is True
