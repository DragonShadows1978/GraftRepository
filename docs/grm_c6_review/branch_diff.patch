+
+        triple = _adjudicate(fake_receipts({"all_legacy": incident}), incident)
+        if not (
+            triple["status"] == "CONVICTED_TRIPLE_MECHANISTIC_INTERACTION"
+            and set(triple["convicted_hooks"]) == set(MECHANISTIC)
+        ):
