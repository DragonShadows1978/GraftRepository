+def tokenizer_ids(tokenizer, text: str) -> np.ndarray:
+    ids = tokenizer(text, add_special_tokens=False).input_ids
+    if ids and isinstance(ids[0], list):
+        ids = ids[0]
+    return np.asarray(ids, dtype=np.int64)
+
